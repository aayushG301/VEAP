# VEAP configuration. Copy to ".env" in the project root (backend + ML service read it automatically).

# ---------------- Database (MongoDB) ----------------
# Local MongoDB / Docker:  mongodb://127.0.0.1:27017
# MongoDB Atlas (free M0): mongodb+srv://<user>:<password>@<cluster>.mongodb.net   (URL-encode special characters in the password)
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=veap

# ---------------- Backend ----------------
# "production" on Render: secrets below become mandatory and Level 2 codes are never shown on screen.
NODE_ENV=development
PORT=4000
# Origin encoded into QR codes = where the FRONTEND is served. Local: http://localhost:5173. Hosted: https://myveap.vercel.app
PUBLIC_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
# Reverse proxies in front of the backend (used for real client IPs, rate limits, anomaly scoring):
#   0 = local dev   1 = Render alone   2 = Vercel rewrite -> Render (the recommended free deployment)
TRUST_PROXY=0

# Signing / encryption secrets (already generated for you; regenerate for every deployment):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
ACCESS_SESSION_SECRET=
QR_SIGNING_SECRET=
PASSWORD_PEPPER=
# Exactly 32 bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it makes existing encrypted profiles unreadable, so set it once per database.
DATA_ENCRYPTION_KEY=

# ---------------- Level 2 verification code delivery ----------------
#   mock     = code shown on screen (local development only; ignored in production)
#   telegram = Code goes to the emergency contact's Telegram, never to the responder's screen (recommended)
#   twilio   = paid SMS (needs the TWILIO_* values)
OTP_MODE=mock

# Telegram (OTP_MODE=telegram): open Telegram, talk to @BotFather, send /newbot, copy the token here.
TELEGRAM_BOT_TOKEN=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
DEFAULT_COUNTRY_CODE=+91

# ---------------- Level 3 emergency override (simulated hospital registry) ----------------
# Seconds the emergency contact has to DENY before access is auto-granted (patient may be unconscious).
BREAK_GLASS_DELAY_SEC=60
BREAK_GLASS_MAX_PER_DAY=3
STAFF_PIN_MAX_FAILURES=5
STAFF_LOCK_MINUTES=15

# ---------------- Demo helpers ----------------
# true = at boot create the demo patient (patient@veap.demo), its QR and the simulated hospital registry. Hosted demos: set true.
DEMO_SEED=false
# Password of the demo accounts. Choose your own for any public deployment.
DEMO_PASSWORD=DemoPassw0rd!
# Last-resort fallback: show the Level 2 code on screen even in production (OTP_MODE=mock). Leave false.
ALLOW_DEMO_OTP=false

# First admin account (created at boot if both are set)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------------- ML service (optional) ----------------
# Leave empty: the backend uses built-in rule-based fallbacks for anomaly scoring and drug checks.
ML_SERVICE_URL=
ML_SERVICE_KEY=change-me-service-key

# ---------------- Rate limits (per IP) ----------------
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=30
SCAN_RATE_LIMIT_MAX=40
OTP_RATE_LIMIT_MAX=8
