# Copy this file to ".env" in the project root. The backend and ML service read it automatically.
# Variables already set in your shell take priority over this file.

# ---------------- Database (MongoDB) ----------------
# Local MongoDB / Docker:  mongodb://127.0.0.1:27017
# MongoDB Atlas:           mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=veap

# ---------------- Backend ----------------
# Use "production" for real deployments (then all secrets below are mandatory and OTPs are never shown on screen)
NODE_ENV=development
PORT=4000
# Origin that is encoded into QR codes (where the frontend is served)
PUBLIC_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Generate each secret with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
ACCESS_SESSION_SECRET=
QR_SIGNING_SECRET=
PASSWORD_PEPPER=
# Exactly 32 bytes, base64. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=

# How Level 2 verification codes are delivered:
#   mock   = the code is shown on screen (demo only, never in production)
#   twilio = the code is texted to the patient's primary emergency contact via Twilio (needs the 3 TWILIO_* values below)
OTP_MODE=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio sender number in E.164 format, e.g. +15005550006
TWILIO_PHONE_NUMBER=
# Used to turn local numbers like "98765 43210" into international format
DEFAULT_COUNTRY_CODE=+91

# First admin account (created at boot if both are set)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------------- ML service ----------------
# Leave ML_SERVICE_URL empty to use the built-in rule-based fallbacks only
ML_SERVICE_URL=http://localhost:8001
# Shared secret: must be identical for the backend and the ML service
ML_SERVICE_KEY=change-me-service-key

# ---------------- Rate limits (per IP) ----------------
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=30
SCAN_RATE_LIMIT_MAX=40
OTP_RATE_LIMIT_MAX=8
